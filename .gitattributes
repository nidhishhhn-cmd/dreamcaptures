# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf
# Explicit binary files (preserves binary integrity)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
# Git Large File Storage (Git LFS) tracking for large video assets
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.MP4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.MOV filter=lfs diff=lfs merge=lfs -text
